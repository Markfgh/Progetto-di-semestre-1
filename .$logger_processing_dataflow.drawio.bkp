        <mxCell id="capture_cmd_q" parent="shared_group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontSize=12;fontStyle=1;" value="GUI → RX command Queue&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;CAPTURE / CAPTURE_STOP + capture ID&lt;/font&gt;" vertex="1">
