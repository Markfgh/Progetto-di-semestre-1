        <mxCell id="capture_meta" parent="shared_group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4F46E5;fontSize=12;fontStyle=1;" value="Capture metadata and session state&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;linear position · output status · saved-frame count&lt;br&gt;active / cancel / completion result&lt;/font&gt;" vertex="1">
          <mxGeometry x="25" y="145" width="310" height="82" as="geometry" />
        </mxCell>
        <mxCell id="raw_ring" parent="shared_group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontSize=14;fontStyle=1;" value="Shared RAW frame ring&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;complete ADC frames + validity + position tag&lt;br&gt;slot ownership: DSP always · logger only during capture&lt;/font&gt;" vertex="1">
          <mxGeometry x="25" y="300" width="310" height="92" as="geometry" />
        </mxCell>
        <mxCell id="free_slots" parent="shared_group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontSize=12;fontStyle=1;" value="Free-slots Queue&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;slot returns only after every assigned consumer releases it&lt;/font&gt;" vertex="1">
          <mxGeometry x="25" y="465" width="310" height="65" as="geometry" />
        </mxCell>
        <mxCell id="shared_note" parent="shared_group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontSize=11;fontStyle=1;dashed=1;" value="Large RAW frames are never copied through the control Queue; the logger reads the shared slot directly." vertex="1">
          <mxGeometry x="25" y="570" width="310" height="55" as="geometry" />
        </mxCell>

        <mxCell id="logger_group" parent="1" style="swimlane;html=1;rounded=1;startSize=28;fillColor=none;strokeColor=#9333EA;fontStyle=1;fontColor=#334155;" value="CAPTURE LOGGER PROCESS" vertex="1">
          <mxGeometry x="1060" y="100" width="380" height="670" as="geometry" />
        </mxCell>
        <mxCell id="logger_wait" parent="logger_group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9333EA;fontSize=13;fontStyle=1;" value="Detect an active capture session&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;read its metadata and target output run&lt;/font&gt;" vertex="1">
          <mxGeometry x="35" y="55" width="310" height="66" as="geometry" />
        </mxCell>
        <mxCell id="logger_open" parent="logger_group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=13;fontStyle=1;" value="Open one capture file and write its header&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;capture ID + linear position metadata&lt;/font&gt;" vertex="1">
          <mxGeometry x="35" y="165" width="310" height="68" as="geometry" />
        </mxCell>
        <mxCell id="logger_claim" parent="logger_group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4F46E5;fontSize=13;fontStyle=1;" value="Claim valid capture-tagged slots&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;read frames directly from the shared RAW ring&lt;/font&gt;" vertex="1">
          <mxGeometry x="35" y="280" width="310" height="68" as="geometry" />
        </mxCell>
        <mxCell id="logger_write" parent="logger_group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=13;fontStyle=1;" value="Append valid RAW frames in blocks&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;update saved-frame progress&lt;/font&gt;" vertex="1">
          <mxGeometry x="35" y="395" width="310" height="66" as="geometry" />
        </mxCell>
        <mxCell id="logger_finish" parent="logger_group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=13;fontStyle=1;" value="Target reached → flush, close and publish result&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;success only after file persistence is confirmed&lt;/font&gt;" vertex="1">
