<mxfile host="app.diagrams.net" agent="Codex">
  <diagram id="logger-capture-pipeline" name="Logger Capture Pipeline">
    <mxGraphModel dx="2200" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#0F172A;" value="CAPTURE LOGGER PIPELINE — PERSISTING LINEAR SAR ACQUISITIONS" vertex="1">
          <mxGeometry x="20" y="15" width="1800" height="32" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#475569;" value="The logger is activated only for a requested capture: it shares the live RAW ring with the realtime DSP, writes a complete capture file, then confirms persistence before the next scan position can begin." vertex="1">
          <mxGeometry x="20" y="48" width="2050" height="24" as="geometry" />
        </mxCell>

        <mxCell id="gui_group" parent="1" style="swimlane;html=1;rounded=1;startSize=28;fillColor=none;strokeColor=#64748B;fontStyle=1;fontColor=#334155;" value="GUI / LINEAR SCAN CONTROLLER" vertex="1">
          <mxGeometry x="20" y="100" width="290" height="670" as="geometry" />
        </mxCell>
        <mxCell id="gui_request" parent="gui_group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=13;fontStyle=1;" value="Manual capture or next linear scan position&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;position ID · carriage position · selected output run&lt;/font&gt;" vertex="1">
          <mxGeometry x="20" y="75" width="250" height="78" as="geometry" />
        </mxCell>
        <mxCell id="gui_session" parent="gui_group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9333EA;fontSize=13;fontStyle=1;" value="Capture session manager&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;requests one capture and tracks its outcome&lt;/font&gt;" vertex="1">
          <mxGeometry x="20" y="215" width="250" height="68" as="geometry" />
        </mxCell>
        <mxCell id="gui_progress" parent="gui_group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4F46E5;fontSize=12;fontStyle=1;" value="Capture progress and result&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;frames saved · completed / cancelled / failed&lt;/font&gt;" vertex="1">
          <mxGeometry x="20" y="365" width="250" height="68" as="geometry" />
        </mxCell>
        <mxCell id="gui_next" parent="gui_group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=12;fontStyle=1;dashed=1;" value="On successful persistence&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;continue the linear scan / enable next capture&lt;/font&gt;" vertex="1">
          <mxGeometry x="20" y="515" width="250" height="65" as="geometry" />
        </mxCell>

        <mxCell id="rx_group" parent="1" style="swimlane;html=1;rounded=1;startSize=28;fillColor=none;strokeColor=#0284C7;fontStyle=1;fontColor=#334155;" value="RX / CAPTURE TAGGING PROCESS" vertex="1">
          <mxGeometry x="330" y="100" width="330" height="670" as="geometry" />
        </mxCell>
        <mxCell id="rx_udp" parent="rx_group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontSize=13;fontStyle=1;" value="UDP receiver and frame assembly&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;complete, validated ADC RAW frames&lt;br&gt;expanded in the realtime dataflow diagram&lt;/font&gt;" vertex="1">
          <mxGeometry x="25" y="65" width="280" height="82" as="geometry" />
        </mxCell>
        <mxCell id="rx_capture" parent="rx_group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=13;fontStyle=1;" value="Receive CAPTURE / STOP request&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;prepare one capture session and wait for settling&lt;/font&gt;" vertex="1">
          <mxGeometry x="25" y="210" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="rx_tag" parent="rx_group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9333EA;fontSize=13;fontStyle=1;" value="Publish capture-tagged RAW slots&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;DSP consumes every valid frame&lt;br&gt;logger ownership is added only while capture is active&lt;/font&gt;" vertex="1">
          <mxGeometry x="25" y="370" width="280" height="88" as="geometry" />
        </mxCell>
        <mxCell id="rx_stop_tag" parent="rx_group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontSize=11;fontStyle=1;dashed=1;" value="Stop tagging when the logger has enough valid frames or the capture is cancelled" vertex="1">
