        </mxCell>

        <mxCell id="shared_group" parent="1" style="swimlane;html=1;rounded=1;startSize=28;fillColor=none;strokeColor=#4F46E5;fontStyle=1;fontColor=#334155;" value="SHARED REALTIME FRAME EXCHANGE" vertex="1">
          <mxGeometry x="680" y="100" width="360" height="670" as="geometry" />
