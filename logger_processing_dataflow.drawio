        <mxCell id="subtitle" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#475569;" value="The logger is activated only for a requested capture: it shares the live RAW ring with the realtime DSP, writes a complete capture file, then confirms persistence before the next scan position can begin." vertex="1">
