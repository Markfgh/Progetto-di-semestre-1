        <mxCell id="title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#0F172A;" value="OFFLINE DSP PIPELINE — SNAPSHOT PREPARATION AND OFFLINE RECONSTRUCTION" vertex="1">
