        <mxCell id="subtitle" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#475569;" value="The Reader prepares the complete zero-Doppler dataset once; the DSP attaches it by shared memory and runs the configured reconstruction. This is not a realtime frame stream." vertex="1">
