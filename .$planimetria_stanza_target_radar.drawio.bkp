        <mxCell id="corr4" value="R4 ↔ M3 / fondo stanza — banchi, vetrate e metallo&#xa;Fasce intense tra Y≈12,5 e 14,5 m&#xa;CONFIDENZA OGGETTO SINGOLO: BASSA" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fillColor=#FFEBEE;strokeColor=#E57373;strokeWidth=2;fontSize=12;fontColor=#8E2424;" vertex="1" parent="1"><mxGeometry x="1160" y="685" width="400" height="96" as="geometry"/></mxCell>
        <mxCell id="corr5" value="R5 — zona vicina al SAR&#xa;Telaio, supporti e risposta di near-field; associazione puntuale non affidabile." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fillColor=#E0F7FA;strokeColor=#26A69A;strokeWidth=2;fontSize=12;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="1160" y="793" width="400" height="82" as="geometry"/></mxCell>

        <mxCell id="notes" value="NOTA METODOLOGICA&#xa;La fotografia prospettica non consente di ricavare misure esatte. Le coordinate seguono la scala della mappa radar; sagome, dimensioni e associazioni laterali sono interpretative. Gli elementi sono separati e modificabili in Draw.io." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#ECEFF1;strokeColor=#78909C;strokeWidth=1;fontSize=11;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="1160" y="900" width="400" height="105" as="geometry"/></mxCell>

        <!-- Callout from central target to correspondence panel -->
        <mxCell id="callout_t1" value="corrispondenza dominante" style="endArrow=block;html=1;rounded=0;dashed=1;dashPattern=6 4;strokeColor=#43A047;strokeWidth=2;fontSize=10;fontColor=#2E7D32;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry"><mxPoint x="680" y="640" as="sourcePoint"/><mxPoint x="1155" y="430" as="targetPoint"/></mxGeometry>
        </mxCell>
